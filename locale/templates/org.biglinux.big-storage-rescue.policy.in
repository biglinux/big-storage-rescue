<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>BigLinux</vendor>
  <vendor_url>https://www.biglinux.com.br</vendor_url>

  <!-- Read-only: lists the processes of every user that keep one mount point busy -->
  <action id="org.biglinux.big-storage-rescue.inspect-processes">
    <description>Show the programs of all users that keep a storage device busy</description>
    <message>Authentication is required to see the programs of all users that are using this device</message>
    <icon_name>big-storage-rescue</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/big-storage-rescue/bsr-holders</annotate>
  </action>

  <!-- A disk image is a raw copy of everything on a drive, the files of every
       user included: the password is asked every time, never kept. Listed
       first, and picked by pkexec for "bsr-drive-helper image" only -->
  <action id="org.biglinux.big-storage-rescue.image">
    <description>Make a disk image of a storage device</description>
    <message>Authentication is required to make a disk image of this storage device. The image holds everything on it.</message>
    <icon_name>big-storage-rescue</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/big-storage-rescue/bsr-drive-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">image</annotate>
  </action>

  <!-- Blocks or allows writing on a device, reads SMART, lists partitions: never changes data on it -->
  <action id="org.biglinux.big-storage-rescue.drive-helper">
    <description>Protect a storage device, read its health or its partitions</description>
    <message>Authentication is required to protect this storage device, read its health or its partitions</message>
    <icon_name>big-storage-rescue</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/big-storage-rescue/bsr-drive-helper</annotate>
  </action>
</policyconfig>
