msgstr "Dispositivo ocupado"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1212
msgid "More options…"
msgstr "Mais opções…"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1217
msgid "Refresh the list"
msgstr "Atualizar a lista"

