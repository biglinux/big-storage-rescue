msgstr "Nenhum dispositivo de armazenamento para diagnosticar foi encontrado."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1046 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1100
msgid "Choose a device:"
msgstr "Escolha um dispositivo:"

