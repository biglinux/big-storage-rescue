msgid "Close"
msgstr "Fechar"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1090
msgid "This folder is not on a local storage device."
msgstr "Esta pasta não está em um dispositivo de armazenamento local."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1118
msgid "Check the drive…"
msgstr "Verificar a unidade…"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1121
msgid "Safely remove…"
msgstr "Remover com segurança…"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1147 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1443
msgid "How to solve"
msgstr "Como resolver"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1168
msgid "Another operation on this drive is in progress. Try again when it finishes."
msgstr "Outra operação nesta unidade está em andamento. Tente novamente quando ela terminar."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1186
msgid "You can now write to this device."
msgstr "Agora você pode gravar neste dispositivo."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1188
msgid "Unable to fix the device"
msgstr "Não foi possível corrigir o dispositivo"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1189
msgid "Nothing was changed on the device. See the technical details for more information."
msgstr "Nada foi alterado no dispositivo. Veja os detalhes técnicos para mais informações."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1212 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1221
