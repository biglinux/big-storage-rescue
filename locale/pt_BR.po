msgid "%d packages have newer versions in the last synchronized package list"
msgstr "%d pacotes têm versões mais novas na última lista de pacotes sincronizada"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:434
msgid "Keep the system consistent: update everything at once (sudo pacman -Syu), never only some packages."
msgstr "Mantenha o sistema consistente: atualize tudo de uma vez (sudo pacman -Syu), nunca apenas alguns pacotes."

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:447
msgid "Big Storage Rescue check (nothing is changed; labels, serial numbers, UUIDs and personal paths are left out)"
msgstr "Verificação do Big Storage Rescue (nada é alterado; rótulos, números de série, UUIDs e caminhos pessoais ficam de fora)"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:455
msgid "Result: %d problem(s), %d warning(s)."
msgstr "Resultado: %d problema(s), %d aviso(s)."

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:456
msgid "Big Storage Rescue and the storage stack look healthy."
msgstr "O Big Storage Rescue e o sistema de armazenamento parecem saudáveis."

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:457
msgid "To report a problem, attach this output: big-storage-rescue --doctor > big-storage-rescue-report.txt"
msgstr "Para relatar um problema, anexe esta saída: big-storage-rescue --doctor > relatorio-big-storage-rescue.txt"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:107
msgid "rsync is not installed, and it does the copying. Install the package rsync."
msgstr "O rsync não está instalado, e é ele quem faz a cópia. Instale o pacote rsync."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:108
msgid "A path has a line break in its name. It cannot be handled safely."
msgstr "Um caminho tem uma quebra de linha no nome. Ele não pode ser tratado com segurança."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:109
msgid "The source folder does not exist or cannot be read."
msgstr "A pasta de origem não existe ou não pode ser lida."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:110
msgid "The source did not answer in time. The drive may be stuck on a damaged area: wait, or unplug it and try again."
msgstr "A origem não respondeu a tempo. A unidade pode estar presa em uma área danificada: aguarde, ou desconecte-a e tente de novo."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:111
msgid "A selected item is outside the source folder."
msgstr "Um item selecionado está fora da pasta de origem."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:112
msgid "A selected item does not exist in the source folder."
msgstr "Um item selecionado não existe na pasta de origem."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:113
msgid "The source and the destination are the same folder."
msgstr "A origem e o destino são a mesma pasta."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:114
msgid "The destination is inside the source. The copy would copy itself."
msgstr "O destino está dentro da origem. A cópia copiaria a si mesma."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:115
msgid "The source is inside the destination, which could overwrite the source."
msgstr "A origem está dentro do destino, o que poderia sobrescrever a origem."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:116
msgid "The source and the destination are on the same filesystem. A copy there does not protect the data."
msgstr "A origem e o destino estão no mesmo sistema de arquivos. Uma cópia ali não protege os dados."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:117
msgid "The destination is on the same physical disk as the source. If that disk fails, both are lost. To accept that, allow it explicitly."
msgstr "O destino está no mesmo disco físico da origem. Se esse disco falhar, os dois se perdem. Para aceitar isso, autorize explicitamente."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:118
msgid "The destination folder could not be created."
msgstr "Não foi possível criar a pasta de destino."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:119
msgid "The destination is read-only."
msgstr "O destino é somente leitura."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:120
msgid "You do not have permission to write to the destination."
msgstr "Você não tem permissão para gravar no destino."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:121
msgid "The destination did not answer in time."
msgstr "O destino não respondeu a tempo."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:122
msgid "The destination is on a drive with critical alerts. To accept that, allow it explicitly."
msgstr "O destino está em uma unidade com alertas críticos. Para aceitar isso, autorize explicitamente."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:123
msgid "This drive is at risk and is mounted with writing enabled. Mount it read-only first, so that nothing changes it during the copy. To accept the risk, allow it explicitly."
msgstr "Esta unidade está em risco e montada com gravação ativada. Monte-a primeiro como somente leitura, para que nada a altere durante a cópia. Para aceitar o risco, autorize explicitamente."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:124
msgid "There is not enough free space at the destination."
msgstr "Não há espaço livre suficiente no destino."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:125 big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:478
msgid "GNU ddrescue is not installed (package ddrescue). It makes the disk image."
msgstr "O GNU ddrescue não está instalado (pacote ddrescue). É ele quem faz a imagem de disco."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:126 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1012
msgid "PhotoRec is not installed (package testdisk)."
msgstr "O PhotoRec não está instalado (pacote testdisk)."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:127 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:711
msgid "TestDisk is not installed (package testdisk)."
msgstr "O TestDisk não está instalado (pacote testdisk)."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:128 big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:477 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:766 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:620
msgid "Permission was not granted."
msgstr "A permissão não foi concedida."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:129 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:759
msgid "Stopped. Nothing was changed on the disk."
msgstr "Interrompido. Nada foi alterado no disco."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:130 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1019
msgid "This device cannot be read by your user. Make a disk image first (big-storage-rescue --cli image), and search in the image: it also spares the disk."
msgstr "Seu usuário não consegue ler este dispositivo. Faça antes uma imagem de disco (big-storage-rescue --cli image) e busque na imagem: isso também poupa o disco."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:131
msgid "The image cannot be stored on the disk being read."
msgstr "A imagem não pode ficar no disco que está sendo lido."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:132
msgid "An image of another disk already exists in that place. Continuing it would mix the two: choose another name."
msgstr "Já existe nesse lugar uma imagem de outro disco. Continuá-la misturaria os dois: escolha outro nome."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:133
msgid "A file with this name already exists and is not an image started here. Choose another name."
msgstr "Já existe um arquivo com esse nome, e ele não é uma imagem iniciada aqui. Escolha outro nome."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:134 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:414 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:619 big-storage-rescue/usr/lib/big-storage-rescue/drive-tui.sh:78
msgid "The device was disconnected or replaced. Nothing was done."
msgstr "O dispositivo foi desconectado ou substituído. Nada foi feito."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:135 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:405
msgid "This computer has no driver for this filesystem. Installing the right package may solve it."
msgstr "Este computador não tem driver para este sistema de arquivos. Instalar o pacote certo pode resolver."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:136 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:410
msgid "This volume is encrypted. Unlock it first."
msgstr "Este volume é criptografado. Desbloqueie-o primeiro."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:137 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:411
msgid "This is a part of a larger volume (RAID, LVM or similar), not a filesystem of its own. Its volume must be assembled first."
msgstr "Isto é parte de um volume maior (RAID, LVM ou semelhante), não um sistema de arquivos próprio. O volume precisa ser montado antes."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:138 big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:413
msgid "This is swap space, not a place for files."
msgstr "Isto é área de swap, não um lugar para arquivos."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:139
msgid "No filesystem was recognized on it, so its files cannot be listed."
msgstr "Nenhum sistema de arquivos foi reconhecido nele, então os arquivos não podem ser listados."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:140
msgid "Choose one of the volumes of this drive to see its files."
msgstr "Escolha um dos volumes deste disco para ver os arquivos."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:141
msgid "This is already a disk image."
msgstr "Isto já é uma imagem de disco."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:142
msgid "Only the files a copy left out can be salvaged."
msgstr "Só é possível salvar os arquivos que uma cópia deixou de fora."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:143
msgid "It is still running. Wait for it to finish, or pause it first."
msgstr "Ainda está em andamento. Espere terminar ou pause primeiro."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:144
msgid "GNU ddrescue is not installed (package ddrescue). It reads what can be read of each file."
msgstr "O GNU ddrescue não está instalado (pacote ddrescue). Ele lê o que dá para ler de cada arquivo."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:145
msgid "This copy left out no file that can still be read: every file was copied, or the ones left out are no longer in the source."
msgstr "Esta cópia não deixou de fora nenhum arquivo que ainda possa ser lido: todos foram copiados, ou os que ficaram de fora não estão mais na origem."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:146
msgid "The copy was refused."
msgstr "A cópia foi recusada."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:165
msgid "The source is mounted with writing enabled. Mounting it read-only is safer."
msgstr "A origem está montada com gravação ativada. Montá-la como somente leitura é mais seguro."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:166
msgid "The source drive reported problems. Files that do not advance are set aside so the rest is saved first."
msgstr "A unidade de origem relatou problemas. Arquivos que não avançam são deixados de lado para salvar o resto primeiro."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:167
msgid "The total is not measured on a drive at risk, to avoid extra reads. Progress shows what was copied so far."
msgstr "O total não é medido em uma unidade em risco, para evitar leituras extras. O progresso mostra o que já foi copiado."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:168
msgid "The total is the used space of the volume: an approximation."
msgstr "O total é o espaço usado do volume: uma aproximação."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:169
msgid "The destination is FAT32, which cannot store files of 4 GiB or more. Those files will be listed as failed."
msgstr "O destino é FAT32, que não guarda arquivos de 4 GiB ou mais. Esses arquivos serão listados como falhas."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:170
msgid "The destination does not store Linux permissions. Names and dates are kept, permissions are not."
msgstr "O destino não guarda permissões do Linux. Nomes e datas são mantidos, as permissões não."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:171
msgid "Some files already exist at the destination with different content. See the option for existing files."
msgstr "Alguns arquivos já existem no destino com conteúdo diferente. Veja a opção para arquivos existentes."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:172
msgid "This version of rsync cannot sync each file to the disk (it needs 3.2.4 or later). After a power cut, the last files copied should be checked."
msgstr "Esta versão do rsync não consegue sincronizar cada arquivo com o disco (precisa da 3.2.4 ou mais nova). Depois de uma queda de energia, confira os últimos arquivos copiados."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:173
msgid "The full check reads every file of the source again. On a drive at risk that is extra wear."
msgstr "A verificação completa lê de novo todos os arquivos da origem. Em uma unidade em risco, isso é desgaste extra."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:391
msgid "Cannot record a name with a line break: %s"
msgstr "Não é possível registrar um nome com quebra de linha: %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:437
msgid "Making the disk image"
msgstr "Fazendo a imagem do disco"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:438
msgid "Disk image complete"
msgstr "Imagem de disco concluída"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:439
msgid "Listing the files"
msgstr "Listando os arquivos"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:440
msgid "List of files complete"
msgstr "Lista de arquivos concluída"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:441
msgid "Searching by content"
msgstr "Procurando pelo conteúdo"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:442
msgid "Search complete"
msgstr "Busca concluída"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:443
msgid "Checking whether what was found is whole"
msgstr "Verificando se o que foi encontrado está inteiro"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:444
msgid "Saving what can be read of each file"
msgstr "Salvando o que dá para ler de cada arquivo"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:445
msgid "Every file was read completely"
msgstr "Todos os arquivos foram lidos por completo"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:448
msgid "Waiting to start"
msgstr "Aguardando o início"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:449
msgid "Measuring what will be copied"
msgstr "Medindo o que será copiado"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:450
msgid "Copying"
msgstr "Copiando"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:451
msgid "Checking the result"
msgstr "Verificando o resultado"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:452
msgid "Stopping: waiting for the disk to answer"
msgstr "Parando: aguardando o disco responder"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:453
msgid "Paused"
msgstr "Pausada"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:454
msgid "Completed and checked"
msgstr "Concluída e verificada"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:455
msgid "Cancelled"
msgstr "Cancelada"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:456
msgid "Failed"
msgstr "Falhou"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:457
msgid "Finished, needs your attention"
msgstr "Terminou, precisa da sua atenção"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:458
msgid "Interrupted (it can be resumed)"
msgstr "Interrompida (pode ser retomada)"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:469
msgid "The source drive was disconnected or unmounted. Connect and mount it again, then resume."
msgstr "A unidade de origem foi desconectada ou desmontada. Conecte e monte de novo, depois retome."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:470
msgid "The destination was disconnected or unmounted. Connect and mount it again, then resume."
msgstr "O destino foi desconectado ou desmontado. Conecte e monte de novo, depois retome."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:471
msgid "The destination ran out of space. Free some space or choose another place, then resume."
msgstr "O destino ficou sem espaço. Libere espaço ou escolha outro lugar, depois retome."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:472
msgid "%s files were set aside because they did not advance. The drive may be getting worse, so the copy stopped."
msgstr "%s arquivos foram deixados de lado porque não avançavam. A unidade pode estar piorando, por isso a cópia parou."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:473
msgid "Some files were not copied. See the list below."
msgstr "Alguns arquivos não foram copiados. Veja a lista abaixo."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:474
msgid "The check found differences between source and destination."
msgstr "A verificação encontrou diferenças entre origem e destino."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:475
msgid "Everything was copied, but the check did not finish: it was cancelled or failed."
msgstr "Tudo foi copiado, mas a verificação não terminou: ela foi cancelada ou falhou."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:476
msgid "rsync stopped with an error. See the log."
msgstr "O rsync parou com um erro. Veja o registro."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:479
msgid "GNU ddrescue stopped with an error. See the log."
msgstr "O GNU ddrescue parou com um erro. Veja o registro."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:480
msgid "A drive of the running system cannot be imaged while it runs. Start the computer from another system (a live USB) to image it."
msgstr "Não é possível fazer a imagem de uma unidade do sistema em execução enquanto ele roda. Inicie o computador por outro sistema (um pendrive live) para fazer a imagem."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:481
msgid "Some areas of the disk could not be read. The image holds everything that could be."
msgstr "Algumas áreas do disco não puderam ser lidas. A imagem guarda tudo o que foi possível ler."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:482
msgid "Some folders could not be read, so the list may be incomplete. See the log."
msgstr "Algumas pastas não puderam ser lidas, então a lista pode estar incompleta. Veja o registro."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:483
msgid "PhotoRec stopped with an error. See the log."
msgstr "O PhotoRec parou com um erro. Veja o registro."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:484
msgid "Some files have areas that could not be read. They were saved with everything else, in a folder of their own, with a list of what is missing."
msgstr "Alguns arquivos têm áreas que não puderam ser lidas. Eles foram salvos com todo o resto, numa pasta própria, com a lista do que falta."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:485
msgid "Some files could not be saved. See the list below."
msgstr "Alguns arquivos não puderam ser salvos. Veja a lista abaixo."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:486
msgid "No file was recognized by its content. That does not prove there is nothing to recover: another method, or a professional, may find more."
msgstr "Nenhum arquivo foi reconhecido pelo conteúdo. Isso não prova que não há nada a recuperar: outro método, ou um profissional, pode encontrar mais."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:576
msgid "its content could not be read"
msgstr "seu conteúdo não pôde ser lido"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1049 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1094
msgid "Source:"
msgstr "Origem:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1049 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1099
msgid "Destination:"
msgstr "Destino:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1051 big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1053
msgid "Files:"
msgstr "Arquivos:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1063 big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1064
msgid "Copied:"
msgstr "Copiado:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1068
msgid "Speed:"
msgstr "Velocidade:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1068
msgid "average"
msgstr "média"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1069 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1107
msgid "Elapsed:"
msgstr "Decorrido:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1070
msgid "Remaining:"
msgstr "Restante:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1071
msgid "Waiting for the disk to answer, for %s seconds"
msgstr "Aguardando o disco responder há %s segundos"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1072
msgid "Current file:"
msgstr "Arquivo atual:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1073
msgid "Set aside:"
msgstr "Deixados de lado:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1074
msgid "Failed:"
msgstr "Falharam:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1114
msgid "Cancelled. Files already copied stay at the destination, and the copy can be resumed."
msgstr "Cancelada. Os arquivos já copiados ficam no destino, e a cópia pode ser retomada."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1130
msgid "Source"
msgstr "Origem"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1139 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1121 big-storage-rescue/usr/lib/big-storage-rescue/drive-salvage.sh:368
msgid "Destination"
msgstr "Destino"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1140
msgid "Files copied"
msgstr "Arquivos copiados"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1141
msgid "Data copied"
msgstr "Dados copiados"

