#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:196
msgid "Critical"
msgstr "Crítico"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:197
msgid "Poor"
msgstr "Ruim"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:198
msgid "Good"
msgstr "Bom"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:199
msgid "Healthy"
msgstr "Saudável"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:200
msgid "Not applicable"
msgstr "Não se aplica"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:201
msgid "Not assessed"
msgstr "Não avaliado"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:209
msgid "Only the system log was consulted. Without the drive's own report (SMART) it cannot be called healthy."
msgstr "Só o registro do sistema foi consultado. Sem o relatório do próprio disco (SMART), ele não pode ser chamado de saudável."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:210
msgid "It has used %s%% of the life its maker rates it for: it is near or past its end."
msgstr "Já usou %s%% da vida útil que o fabricante garante: está perto do fim ou já passou dele."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:211
msgid "It has used %s%% of the life its maker rates it for."
msgstr "Já usou %s%% da vida útil que o fabricante garante."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:212
msgid "Some of its SMART values were below their safe limit in the past."
msgstr "Alguns valores do SMART dele já ficaram abaixo do limite seguro no passado."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:215
msgid "Powered on for %s hours, about %s years of use: failures become more likely."
msgstr "Ligado por %s horas, cerca de %s anos de uso: falhas ficam mais prováveis."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:217
msgid "It is hot now (%s °C). Heat shortens its life: give it air."
msgstr "Está quente agora (%s °C). O calor encurta a vida dele: deixe-o ventilado."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:223
msgid "Critical: high risk for the data"
msgstr "Crítico: alto risco para os dados"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:224
msgid "Attention: needs a closer look"
msgstr "Atenção: precisa de uma análise"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:227
msgid "No alerts (SMART and system log checked)"
msgstr "Sem alertas (SMART e registro do sistema verificados)"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:228
msgid "No alerts in the system log (SMART not read)"
msgstr "Sem alertas no registro do sistema (SMART não lido)"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:229
msgid "No alerts from SMART (system log not readable)"
msgstr "Sem alertas do SMART (registro do sistema ilegível)"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:232
msgid "Not applicable (a disk image)"
msgstr "Não se aplica (uma imagem de disco)"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:233
msgid "Unknown: not enough information"
msgstr "Desconhecido: informações insuficientes"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:241
msgid "The drive has sectors it can no longer read (%s pending), even if its overall verdict says PASSED."
msgstr "A unidade tem setores que não consegue mais ler (%s pendentes), mesmo que o veredito geral dela diga PASSED."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:242
msgid "The NVMe drive raised a critical warning (%s)."
msgstr "A unidade NVMe emitiu um aviso crítico (%s)."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:243
msgid "The NVMe drive recorded %s media or data integrity errors."
msgstr "A unidade NVMe registrou %s erros de mídia ou integridade de dados."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:248
msgid "The drive already replaced damaged sectors with spare ones."
msgstr "A unidade já substituiu setores danificados por setores reserva."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:249
msgid "The drive reported %s errors it could not correct."
msgstr "A unidade relatou %s erros que não conseguiu corrigir."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:250
msgid "The cable or adapter corrupted data in transit %s times (CRC errors)."
msgstr "O cabo ou o adaptador corrompeu dados em trânsito %s vezes (erros de CRC)."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:251
msgid "%s of its SMART values are below their safe limit now."
msgstr "%s valores do SMART dele estão abaixo do limite seguro agora."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:252
msgid "The last self-test of the drive found an error: some of its sectors cannot be read."
msgstr "O último autoteste da unidade encontrou um erro: alguns setores dela não podem ser lidos."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:311 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:239
msgid "Type"
msgstr "Tipo"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:312 big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:243
msgid "Capacity"
msgstr "Capacidade"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:318
msgid "SMART verdict"
msgstr "Veredito do SMART"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:320
msgid "What was found:"
msgstr "O que foi encontrado:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:324
msgid "Why it is not called healthy:"
msgstr "Por que não é chamado de saudável:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:331
msgid "Volumes:"
msgstr "Volumes:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:340
msgid "no driver for this filesystem on this computer"
msgstr "sem driver para este sistema de arquivos neste computador"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:342
msgid "writing blocked on the device"
msgstr "gravação bloqueada no dispositivo"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:348
msgid "For the SMART details of the drive, which need the administrator password: big-storage-rescue --cli diagnose DEVICE --smart"
msgstr "Para os detalhes de SMART da unidade, que pedem a senha de administrador: big-storage-rescue --cli diagnose DISPOSITIVO --smart"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:358
msgid "Copy what matters now, starting with the most important files. Every extra read wears a failing disk."
msgstr "Copie agora o que importa, começando pelos arquivos mais importantes. Cada leitura extra desgasta um disco que está falhando."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:359
msgid "Do not run repair tools on this disk: they write, and they can destroy what is still readable."
msgstr "Não use ferramentas de reparo neste disco: elas gravam e podem destruir o que ainda é legível."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:360
msgid "If the data is very important and cannot be replaced, consider a data recovery professional before insisting."
msgstr "Se os dados forem muito importantes e insubstituíveis, considere um profissional de recuperação antes de insistir."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:363
msgid "Copy your important files to another place."
msgstr "Copie seus arquivos importantes para outro lugar."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:364
msgid "Try another cable and connect the drive directly to the computer, without a hub."
msgstr "Experimente outro cabo e conecte a unidade direto no computador, sem hub."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:404
msgid "Permission to mount was not granted."
msgstr "A permissão para montar não foi concedida."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:406
msgid "Windows left this partition hibernated (Fast Startup). It can be read only after Windows shuts down completely."
msgstr "O Windows deixou esta partição hibernada (Inicialização Rápida). Ela só pode ser lida depois que o Windows desligar por completo."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:407
msgid "The drive could not read the start of this filesystem. This is usually damage on the disk, a bad cable or a weak USB port. Making a disk image with GNU ddrescue is the safest next step."
msgstr "A unidade não conseguiu ler o início deste sistema de arquivos. Em geral é dano no disco, cabo ruim ou porta USB fraca. Fazer uma imagem de disco com o GNU ddrescue é o próximo passo mais seguro."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:408
msgid "The structure of this filesystem seems damaged, or this is not the filesystem it claims to be. Nothing was repaired. A disk image or a search for files (PhotoRec) may still recover data."
msgstr "A estrutura deste sistema de arquivos parece danificada, ou ele não é o que afirma ser. Nada foi reparado. Uma imagem de disco ou uma busca por arquivos (PhotoRec) ainda pode recuperar dados."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:409
msgid "This filesystem was not closed properly and needs to replay its journal, which writes to the disk. To protect the data that was not done. A disk image, worked on as a copy, is the safe way to read it."
msgstr "Este sistema de arquivos não foi fechado corretamente e precisa reproduzir o journal, o que grava no disco. Para proteger os dados, isso não foi feito. Uma imagem de disco, usada como cópia, é o jeito seguro de lê-lo."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:412
msgid "No filesystem was recognized on it. If it should have partitions, searching for them with TestDisk does not change the disk."
msgstr "Nenhum sistema de arquivos foi reconhecido. Se deveria ter partições, procurá-las com o TestDisk não altera o disco."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:415
msgid "This drive reported problems, so it is only mounted read-only. Writing to it can destroy what is still readable."
msgstr "Esta unidade relatou problemas, por isso só é montada como somente leitura. Gravar nela pode destruir o que ainda é legível."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:416
msgid "It is already mounted with writing enabled. Unmount it first to mount it read-only (big-storage-rescue --cli mount DEVICE --remount)."
msgstr "Já está montado com gravação ativada. Desmonte primeiro para montar como somente leitura (big-storage-rescue --cli mount DISPOSITIVO --remount)."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:417
msgid "It is in use, so it could not be unmounted to be mounted again."
msgstr "Está em uso, por isso não pôde ser desmontado para montar de novo."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:418
msgid "Writing could not be blocked on the drive: another volume of it is mounted with writing enabled. Unmount it first."
msgstr "Não foi possível bloquear a gravação na unidade: outro volume dela está montado com gravação ativada. Desmonte-o primeiro."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:419
msgid "Writing cannot be blocked on the drive of the running system, so the volume was not mounted."
msgstr "A gravação não pode ser bloqueada na unidade do sistema em execução, então o volume não foi montado."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:420
msgid "The reason could not be determined. Nothing was changed on the device. See the technical details."
msgstr "Não foi possível determinar o motivo. Nada foi alterado no dispositivo. Veja os detalhes técnicos."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:98
msgid "Only a disk image has a map."
msgstr "Só uma imagem de disco tem mapa."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:104
msgid "Nothing has been read yet."
msgstr "Nada foi lido ainda."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:117
msgid "Read: %s of %s. Could not be read: %s."
msgstr "Lido: %s de %s. Não pôde ser lido: %s."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:121
msgid "already read"
msgstr "já lido"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:121
msgid "hard to read, to be retried"
msgstr "difícil de ler, a tentar de novo"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:121
msgid "could not be read"
msgstr "não pôde ser lido"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:121
msgid "not read yet"
msgstr "ainda não lido"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:182
msgid "This image already exists. It continues where it stopped, reading only what is still missing."
msgstr "Esta imagem já existe. Ela continua de onde parou, lendo só o que ainda falta."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:183
msgid "Files found by content lose their original names and folders."
msgstr "Arquivos encontrados por conteúdo perdem os nomes e as pastas originais."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:184
msgid "This drive reported problems. Reading all of it can make it worse: the disk image is read only once, and only with your consent."
msgstr "Este disco relatou problemas. Ler tudo pode piorar a situação: a imagem de disco lê uma única vez, e só com o seu consentimento."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:185
msgid "Making the list goes through all the folders. On a drive with problems this is extra wear."
msgstr "Fazer a lista percorre todas as pastas. Em um disco com problemas, isso é desgaste extra."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:186
msgid "What cannot be read of a file is left as zeros. Files with such areas go to a folder of their own, with a list of what is missing."
msgstr "O que não puder ser lido de um arquivo fica com zeros. Arquivos com essas áreas vão para uma pasta própria, com a lista do que falta."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:187
msgid "Retries read the damaged areas again. They may save a little more, and wear a failing drive more."
msgstr "As novas tentativas leem de novo as áreas danificadas. Podem salvar um pouco mais, e desgastam mais uma unidade com falhas."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:188
msgid "This SSD erases deleted blocks by itself (TRIM). Files deleted some time ago may be gone for good, however deep the search."
msgstr "Este SSD apaga sozinho os blocos excluídos (TRIM). Arquivos excluídos há algum tempo podem ter sumido de vez, por mais profunda que seja a busca."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:296
msgid "Both --source DEVICE and --image FILE are needed."
msgstr "--source DISPOSITIVO e --image ARQUIVO são necessários."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:351
msgid "The image needs %s of free space at the destination."
msgstr "A imagem precisa de %s livres no destino."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:433
msgid "Photos"
msgstr "Fotos"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:434
msgid "Videos"
msgstr "Vídeos"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:435
msgid "Documents"
msgstr "Documentos"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:436
msgid "Audio"
msgstr "Áudio"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:437
msgid "Compressed files"
msgstr "Arquivos compactados"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:438
msgid "Other files"
msgstr "Outros arquivos"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:446
msgid "HEIC and WebP photos are found only when searching all types."
msgstr "Fotos HEIC e WebP só são encontradas ao procurar todos os tipos."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:447
msgid "WAV audio can appear among the results: it has the same signature as AVI."
msgstr "Áudios WAV podem aparecer nos resultados: têm a mesma assinatura do AVI."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:448
msgid "AVI and WMV videos can appear among the results, and M4A audio is found only when searching all types."
msgstr "Vídeos AVI e WMV podem aparecer nos resultados, e áudios M4A só são encontrados ao procurar todos os tipos."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:449
msgid "Word, Excel and LibreOffice files share a signature with ZIP files, so those appear too."
msgstr "Arquivos do Word, Excel e LibreOffice têm a mesma assinatura dos ZIP, então estes também aparecem."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:450
msgid "Word, Excel and LibreOffice files can appear among the results: they are ZIP files inside."
msgstr "Arquivos do Word, Excel e LibreOffice podem aparecer nos resultados: por dentro, eles são ZIP."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:641 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1062
msgid "Search started: %s"
msgstr "Busca iniciada: %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:874
msgid "Only files found by content are checked this way."
msgstr "Só os arquivos encontrados pelo conteúdo são verificados assim."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:891
msgid "Look whole"
msgstr "Parecem inteiros"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:892
msgid "Cut short"
msgstr "Cortado"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:893
msgid "Damaged"
msgstr "Danificado"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:894
msgid "Not checked (format)"
msgstr "Não verificados (formato)"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:895
msgid "Whole means the structure of the file is complete. It does not prove every byte is right: open the files that matter."
msgstr "Inteiro quer dizer que a estrutura do arquivo está completa. Isso não prova que cada byte está certo: abra os arquivos que importam."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1048 big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1087
msgid "%s files found by content in %s. Their original names and folders could not be kept."
msgstr "%s arquivos encontrados por conteúdo em %s. Os nomes e pastas originais não puderam ser mantidos."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1096
msgid "Files listed:"
msgstr "Arquivos listados:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1097
msgid "Files examined:"
msgstr "Arquivos examinados:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1100
msgid "Candidates found:"
msgstr "Candidatos encontrados:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1104
msgid "Read:"
msgstr "Lido:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1117
msgid "Files listed"
msgstr "Arquivos listados"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1118
msgid "Files examined"
msgstr "Arquivos examinados"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1119
msgid "These files exist on the volume. Files that were deleted are not on this list."
msgstr "Estes arquivos existem no volume. Arquivos excluídos não estão nesta lista."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1122
msgid "Candidates found"
msgstr "Candidatos encontrados"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1123
msgid "Found by content: their original names and folders could not be kept, and some may be incomplete. Open them to check."
msgstr "Encontrados por conteúdo: os nomes e pastas originais não puderam ser mantidos, e alguns podem estar incompletos. Abra para conferir."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1129
msgid "Could not be read:"
msgstr "Não puderam ser lidos:"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1154
msgid "Only a list or a search has results."
msgstr "Só uma lista ou uma busca têm resultados."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1175
msgid "The list is not ready yet."
msgstr "A lista ainda não está pronta."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1199
msgid "This command only answers with --json."
msgstr "Este comando só responde com --json."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1277
msgid "This is a disk image: searching it does not touch any disk."
msgstr "Isto é uma imagem de disco: procurar nela não toca em nenhum disco."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1281
msgid "The drive reported problems. For the whole drive, a disk image reads it only once. To copy files, choose one of its volumes."
msgstr "O disco relatou problemas. No disco inteiro, uma imagem de disco o lê uma única vez. Para copiar arquivos, escolha um dos volumes dele."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1285
msgid "For the whole drive, files are searched by their content. To copy files, choose one of its volumes."
msgstr "No disco inteiro, os arquivos são procurados pelo conteúdo. Para copiar arquivos, escolha um dos volumes dele."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1289
msgid "The drive reported problems: copy what matters first, without going through everything."
msgstr "O disco relatou problemas: copie primeiro o que importa, sem percorrer tudo."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1293
msgid "The drive reported problems and its files cannot be opened: a disk image reads it only once, and the search is done on the image."
msgstr "O disco relatou problemas e os arquivos não abrem: uma imagem de disco o lê uma única vez, e a busca é feita na imagem."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1297
msgid "The files can be read normally: list them, and choose what to copy."
msgstr "Os arquivos podem ser lidos normalmente: liste-os e escolha o que copiar."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1301
msgid "The files cannot be opened normally: search for them by content."
msgstr "Os arquivos não abrem normalmente: procure-os pelo conteúdo."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-salvage.sh:110
msgid "%s files (%s) would be read again with GNU ddrescue, from %s to %s."
msgstr "%s arquivos (%s) seriam lidos de novo com o GNU ddrescue, de %s para %s."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-salvage.sh:120
