msgstr "Não foi possível acessar o dispositivo de armazenamento"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1068
msgid "Big Storage Rescue could not identify this storage device. It may have been disconnected or become temporarily unavailable."
msgstr "O Big Storage Rescue não conseguiu identificar este dispositivo de armazenamento. Ele pode ter sido desconectado ou estar temporariamente indisponível."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1069
msgid "If you disconnected it, connect it again and choose Try again."
msgstr "Se você o desconectou, conecte-o novamente e escolha Tentar novamente."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1070 big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1212
msgid "Try again"
msgstr "Tentar novamente"

