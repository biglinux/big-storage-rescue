msgstr "Le périphérique a été déconnecté ou remplacé pendant l’opération. Rien d’autre n’a été fait."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:799
msgid "%s was mounted again at %s"
msgstr "%s a été remonté sur %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:815
msgid "%s: the encrypted volume could not be locked"
msgstr "%s : le volume chiffré n’a pas pu être verrouillé"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:857
msgid "They do not start again by themselves when the device comes back."
msgstr "Ils ne redémarrent pas d’eux-mêmes quand le périphérique revient."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:859
msgid "They start again by themselves when the device is mounted again."
msgstr "Ils redémarrent d’eux-mêmes quand le périphérique est remonté."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:902
#: big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:514
