msgstr "Les fermer"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:936
#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:949
#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1215
#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1280
#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1304
#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1377
msgid "Cancel"
msgstr "Annuler"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:939
msgid "Still running: %s"
msgstr "Toujours en cours d’exécution : %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:942
#: big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:538
msgid "These services use the device and will be stopped when it is unmounted:"
msgstr "Ces services utilisent le périphérique et seront arrêtés lors du démontage :"

