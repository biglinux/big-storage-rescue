msgid "disk images"
msgstr "images disque"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:265
msgid "lost partitions"
msgstr "partitions perdues"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:265
msgid "search by content"
msgstr "recherche par contenu"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:267
msgid "Drive manager, %s: %s"
msgstr "Gestionnaire de disques, %s : %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:268
msgid "Drive manager, %s: %s is not installed"
msgstr "Gestionnaire de disques, %s : %s n’est pas installé"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:271
msgid "Application and dialogs: GTK 4 and libadwaita"
msgstr "Application et boîtes de dialogue : GTK 4 et libadwaita"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:272
msgid "The application and the dialogs need gtk4, libadwaita 1.5 or later and python-gobject: big-storage-rescue --gui cannot open and questions are asked in the terminal. big-storage-rescue --cli works without them"
msgstr "L’application et les boîtes de dialogue nécessitent gtk4, libadwaita 1.5 ou version ultérieure et python-gobject : big-storage-rescue --gui ne peut pas s’ouvrir et les questions sont posées dans le terminal. big-storage-rescue --cli fonctionne sans eux"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:274
msgid "Notifications: notify-send"
msgstr "Notifications : notify-send"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:275
msgid "notify-send (libnotify) is not installed: no notifications"
msgstr "notify-send (libnotify) n’est pas installé : aucune notification"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:275
msgid "Install libnotify."
msgstr "Installez libnotify."

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:278
msgid "No session D-Bus: notifications cannot be shown"
msgstr "Pas de D-Bus de session : les notifications ne peuvent pas être affichées"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:283
msgid "The read-only notifier is off (it can be turned on in the menu of the application)"
msgstr "Le notificateur de lecture seule est désactivé (il peut être activé dans le menu de l’application)"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:285
msgid "The read-only notifier is running"
msgstr "Le notificateur de lecture seule est en cours d’exécution"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:287
msgid "The read-only notifier is on but not running"
msgstr "Le notificateur de lecture seule est activé mais ne s’exécute pas"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:287
msgid "It starts at the next login."
msgstr "Il démarre à la prochaine connexion."

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:298
msgid "Storage stack"
msgstr "Pile de stockage"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:309
msgid "Missing program: %s"
msgstr "Programme manquant : %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:310
msgid "Install the dependencies of big-storage-rescue (util-linux, udisks2, lsof, glib2)."
msgstr "Installez les dépendances de big-storage-rescue (util-linux, udisks2, lsof, glib2)."

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:313
msgid "UDisks2 answers on the system D-Bus"
msgstr "UDisks2 répond sur le D-Bus système"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:315
msgid "UDisks2 does not answer on the system D-Bus"
msgstr "UDisks2 ne répond pas sur le D-Bus système"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:315
msgid "Plasma and Big Storage Rescue cannot mount or remove devices. Check: systemctl status udisks2"
msgstr "Plasma et Big Storage Rescue ne peuvent ni monter ni retirer de périphériques. Vérifiez : systemctl status udisks2"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:319
msgid "Polkit knows the action of Big Storage Rescue"
msgstr "Polkit connaît l’action de Big Storage Rescue"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:321
msgid "Polkit does not know org.biglinux.big-storage-rescue.inspect-processes"
msgstr "Polkit ne connaît pas org.biglinux.big-storage-rescue.inspect-processes"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:321
msgid "'Show programs of all users' will not work. Reinstall the big-storage-rescue package."
msgstr "« Afficher les programmes de tous les utilisateurs » ne fonctionnera pas. Réinstallez le paquet big-storage-rescue."

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:325
msgid "Kernel log readable (needed to explain read-only devices)"
msgstr "Journal du noyau lisible (nécessaire pour expliquer les périphériques en lecture seule)"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:327
msgid "Kernel log not readable by this user: read-only causes are explained with fewer details"
msgstr "Journal du noyau non lisible par cet utilisateur : les causes de lecture seule sont expliquées avec moins de détails"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:340
msgid "%s: %s, %s, removable"
msgstr "%s : %s, %s, amovible"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:342
msgid "%s: %s, %s, internal"
msgstr "%s : %s, %s, interne"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:346
msgid "The kernel has no /sys/block entry for it"
msgstr "Le noyau n’a aucune entrée /sys/block pour lui"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:348
msgid "UDisks2 does not know this device: Plasma and Big Storage Rescue cannot manage it"
msgstr "UDisks2 ne connaît pas ce périphérique : Plasma et Big Storage Rescue ne peuvent pas le gérer"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:355
msgid "%s: the drive reports problems (%s)"
msgstr "%s : le disque signale des problèmes (%s)"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:356
#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:363
msgid "For details: big-storage-rescue --diagnose %s"
msgstr "Pour plus de détails : big-storage-rescue --diagnose %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:362
msgid "%s: errors in %s of the last %s starts of the computer (%s kernel messages)"
msgstr "%s : erreurs lors de %s des %s derniers démarrages de l’ordinateur (%s messages du noyau)"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:367
msgid "%s: its filesystems recorded %s errors, kept across restarts"
msgstr "%s : ses systèmes de fichiers ont enregistré %s erreurs, conservées d’un redémarrage à l’autre"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:378
msgid "NVMe controller /dev/%s: storage %s"
msgstr "Contrôleur NVMe /dev/%s : stockage %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:391
msgid "Mounted read-only: %s"
msgstr "Monté en lecture seule : %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:403
msgid "Enough free space, and nothing left mounted by os-prober"
msgstr "Assez d’espace libre, et rien n’est resté monté par os-prober"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:418
msgid "Outside Big Storage Rescue (for reference)"
msgstr "En dehors de Big Storage Rescue (pour information)"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:424
msgid "Settings files that do not belong to you (Plasma cannot save them, so settings seem to reset)"
msgstr "Fichiers de configuration qui ne vous appartiennent pas (Plasma ne peut pas les enregistrer, les paramètres semblent donc se réinitialiser)"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:425
msgid "Usually left by a graphical program run with sudo. An administrator can give them back with chown."
msgstr "Généralement laissés par un programme graphique lancé avec sudo. Un administrateur peut vous les rendre avec chown."

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:427
msgid "All your settings files belong to you"
msgstr "Tous vos fichiers de configuration vous appartiennent"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:433
msgid "%d packages have newer versions in the last synchronized package list"
msgstr "%d paquets ont des versions plus récentes dans la dernière liste de paquets synchronisée"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:434
msgid "Keep the system consistent: update everything at once (sudo pacman -Syu), never only some packages."
msgstr "Gardez le système cohérent : mettez tout à jour en une fois (sudo pacman -Syu), jamais seulement quelques paquets."

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:447
msgid "Big Storage Rescue check (nothing is changed; labels, serial numbers, UUIDs and personal paths are left out)"
msgstr "Vérification de Big Storage Rescue (rien n’est modifié ; les étiquettes, numéros de série, UUID et chemins personnels sont omis)"

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:455
msgid "Result: %d problem(s), %d warning(s)."
msgstr "Résultat : %d problème(s), %d avertissement(s)."

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:456
msgid "Big Storage Rescue and the storage stack look healthy."
msgstr "Big Storage Rescue et la pile de stockage semblent en bon état."

#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:457
msgid "To report a problem, attach this output: big-storage-rescue --doctor > big-storage-rescue-report.txt"
msgstr "Pour signaler un problème, joignez cette sortie : big-storage-rescue --doctor > big-storage-rescue-report.txt"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:107
msgid "rsync is not installed, and it does the copying. Install the package rsync."
msgstr "rsync n’est pas installé, or c’est lui qui effectue la copie. Installez le paquet rsync."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:108
msgid "A path has a line break in its name. It cannot be handled safely."
msgstr "Un chemin contient un saut de ligne dans son nom. Il ne peut pas être traité en toute sécurité."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:109
msgid "The source folder does not exist or cannot be read."
msgstr "Le dossier source n’existe pas ou ne peut pas être lu."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:110
msgid "The source did not answer in time. The drive may be stuck on a damaged area: wait, or unplug it and try again."
msgstr "La source n’a pas répondu à temps. Le disque est peut-être bloqué sur une zone endommagée : patientez, ou débranchez-le et réessayez."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:111
msgid "A selected item is outside the source folder."
msgstr "Un élément sélectionné se trouve en dehors du dossier source."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:112
msgid "A selected item does not exist in the source folder."
msgstr "Un élément sélectionné n’existe pas dans le dossier source."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:113
msgid "The source and the destination are the same folder."
msgstr "La source et la destination sont le même dossier."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:114
msgid "The destination is inside the source. The copy would copy itself."
msgstr "La destination se trouve dans la source. La copie se copierait elle-même."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:115
msgid "The source is inside the destination, which could overwrite the source."
msgstr "La source se trouve dans la destination, ce qui pourrait écraser la source."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:116
msgid "The source and the destination are on the same filesystem. A copy there does not protect the data."
msgstr "La source et la destination sont sur le même système de fichiers. Une copie à cet endroit ne protège pas les données."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:117
msgid "The destination is on the same physical disk as the source. If that disk fails, both are lost. To accept that, allow it explicitly."
msgstr "La destination est sur le même disque physique que la source. Si ce disque tombe en panne, les deux sont perdues. Pour l’accepter, autorisez-le explicitement."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:118
msgid "The destination folder could not be created."
msgstr "Le dossier de destination n’a pas pu être créé."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:119
msgid "The destination is read-only."
msgstr "La destination est en lecture seule."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:120
msgid "You do not have permission to write to the destination."
msgstr "Vous n’avez pas l’autorisation d’écrire dans la destination."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:121
msgid "The destination did not answer in time."
msgstr "La destination n’a pas répondu à temps."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:122
msgid "The destination is on a drive with critical alerts. To accept that, allow it explicitly."
msgstr "La destination se trouve sur un disque qui présente des alertes critiques. Pour l’accepter, autorisez-le explicitement."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:123
msgid "This drive is at risk and is mounted with writing enabled. Mount it read-only first, so that nothing changes it during the copy. To accept the risk, allow it explicitly."
msgstr "Ce disque est à risque et il est monté avec l’écriture activée. Montez-le d’abord en lecture seule, pour que rien ne le modifie pendant la copie. Pour accepter le risque, autorisez-le explicitement."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:124
msgid "There is not enough free space at the destination."
msgstr "Il n’y a pas assez d’espace libre à la destination."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:125
#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:486
msgid "GNU ddrescue is not installed (package ddrescue). It makes the disk image."
msgstr "GNU ddrescue n’est pas installé (paquet ddrescue). C’est lui qui crée l’image disque."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:126
#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1024
msgid "PhotoRec is not installed (package testdisk)."
msgstr "PhotoRec n’est pas installé (paquet testdisk)."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:127
#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:723
msgid "TestDisk is not installed (package testdisk)."
msgstr "TestDisk n’est pas installé (paquet testdisk)."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:128
#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:485
#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:778
#: big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:646
msgid "Permission was not granted."
msgstr "L’autorisation n’a pas été accordée."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:129
#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:771
msgid "Stopped. Nothing was changed on the disk."
msgstr "Arrêté. Rien n’a été modifié sur le disque."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:130
#: big-storage-rescue/usr/lib/big-storage-rescue/drive-recovery.sh:1031
msgid "This device cannot be read by your user. Make a disk image first (big-storage-rescue --cli image), and search in the image: it also spares the disk."
msgstr "Ce périphérique ne peut pas être lu par votre utilisateur. Créez d’abord une image disque (big-storage-rescue --cli image), puis lancez la recherche dans l’image : cela ménage aussi le disque."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:131
msgid "The image cannot be stored on the disk being read."
msgstr "L’image ne peut pas être enregistrée sur le disque en cours de lecture."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:132
msgid "It cannot be told which disk holds this folder (an overlay, a FUSE folder without a device, or a share of this computer), so the image could end up on the disk being read. Choose a folder on another drive."
msgstr "Impossible de savoir quel disque contient ce dossier (une superposition, un dossier FUSE sans périphérique ou un partage de cet ordinateur) : l’image pourrait se retrouver sur le disque en cours de lecture. Choisissez un dossier sur un autre disque."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:133
msgid "An image of another disk already exists in that place. Continuing it would mix the two: choose another name."
msgstr "Une image d’un autre disque existe déjà à cet emplacement. La poursuivre mélangerait les deux : choisissez un autre nom."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:134
msgid "A file with this name already exists and is not an image started here. Choose another name."
msgstr "Un fichier portant ce nom existe déjà et n’est pas une image commencée ici. Choisissez un autre nom."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:135
#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:421
#: big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:645
#: big-storage-rescue/usr/lib/big-storage-rescue/drive-tui.sh:78
msgid "The device was disconnected or replaced. Nothing was done."
msgstr "Le périphérique a été déconnecté ou remplacé. Rien n’a été fait."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:136
#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:412
msgid "This computer has no driver for this filesystem. Installing the right package may solve it."
msgstr "Cet ordinateur n’a pas de pilote pour ce système de fichiers. Installer le bon paquet peut résoudre le problème."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:137
#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:417
msgid "This volume is encrypted. Unlock it first."
msgstr "Ce volume est chiffré. Déverrouillez-le d’abord."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:138
#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:418
msgid "This is a part of a larger volume (RAID, LVM or similar), not a filesystem of its own. Its volume must be assembled first."
msgstr "Il s’agit d’une partie d’un volume plus grand (RAID, LVM ou similaire), pas d’un système de fichiers à part entière. Son volume doit d’abord être assemblé."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:139
#: big-storage-rescue/usr/lib/big-storage-rescue/drive-diag.sh:420
msgid "This is swap space, not a place for files."
msgstr "Il s’agit d’un espace d’échange, pas d’un emplacement pour des fichiers."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:140
msgid "No filesystem was recognized on it, so its files cannot be listed."
msgstr "Aucun système de fichiers n’y a été reconnu : ses fichiers ne peuvent donc pas être listés."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:141
msgid "Choose one of the volumes of this drive to see its files."
msgstr "Choisissez l’un des volumes de ce disque pour voir ses fichiers."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:142
msgid "This is already a disk image."
msgstr "Il s’agit déjà d’une image disque."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:143
msgid "Only the files a copy left out can be salvaged."
msgstr "Seul un sauvetage partiel des fichiers omis par une copie est possible."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:144
#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:1228
msgid "It is still running. Wait for it to finish, or pause it first."
msgstr "Elle est toujours en cours. Attendez qu’elle se termine, ou mettez-la d’abord en pause."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:145
msgid "GNU ddrescue is not installed (package ddrescue). It reads what can be read of each file."
msgstr "GNU ddrescue n’est pas installé (paquet ddrescue). C’est lui qui lit ce qui peut être lu de chaque fichier."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:146
msgid "This copy left out no file that can still be read: every file was copied, or the ones left out are no longer in the source."
msgstr "Cette copie n’a omis aucun fichier encore lisible : tous les fichiers ont été copiés, ou ceux qui ont été omis ne sont plus dans la source."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:147
msgid "The copy was refused."
msgstr "La copie a été refusée."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:166
msgid "The source is mounted with writing enabled. Mounting it read-only is safer."
msgstr "La source est montée avec l’écriture activée. La monter en lecture seule est plus sûr."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:167
msgid "The source drive reported problems. Files that do not advance are set aside so the rest is saved first."
msgstr "Le disque source a signalé des problèmes. Les fichiers qui n’avancent pas sont mis de côté pour que le reste soit sauvé en premier."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:168
msgid "The total is not measured on a drive at risk, to avoid extra reads. Progress shows what was copied so far."
msgstr "Le total n’est pas mesuré sur un disque à risque, pour éviter des lectures supplémentaires. La progression montre ce qui a été copié jusqu’ici."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:169
msgid "The total is the used space of the volume: an approximation."
msgstr "Le total correspond à l’espace utilisé du volume : c’est une approximation."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:170
msgid "The destination is FAT32, which cannot store files of 4 GiB or more. Those files will be listed as failed."
msgstr "La destination est en FAT32, qui ne peut pas stocker de fichiers de 4 Gio ou plus. Ces fichiers seront listés comme ayant échoué."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:171
msgid "The destination does not store Linux permissions. Names and dates are kept, permissions are not."
msgstr "La destination ne conserve pas les permissions Linux. Les noms et les dates sont conservés, les permissions non."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:172
msgid "Some files already exist at the destination with different content. See the option for existing files."
msgstr "Certains fichiers existent déjà à la destination avec un contenu différent. Voir l’option pour les fichiers existants."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:173
msgid "This version of rsync cannot sync each file to the disk (it needs 3.2.4 or later). After a power cut, the last files copied should be checked."
msgstr "Cette version de rsync ne peut pas synchroniser chaque fichier sur le disque (il faut la version 3.2.4 ou ultérieure). Après une coupure de courant, les derniers fichiers copiés devront être vérifiés."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:174
msgid "The full check reads every file of the source again. On a drive at risk that is extra wear."
msgstr "La vérification complète relit tous les fichiers de la source. Sur un disque à risque, c’est une usure supplémentaire."

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:392
msgid "Cannot record a name with a line break: %s"
msgstr "Impossible d’enregistrer un nom contenant un saut de ligne : %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:440
msgid "Making the disk image"
msgstr "Création de l’image disque"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:441
msgid "Disk image complete"
msgstr "Image disque terminée"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:442
msgid "Listing the files"
msgstr "Liste des fichiers en cours"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:443
msgid "List of files complete"
msgstr "Liste des fichiers terminée"

#: big-storage-rescue/usr/lib/big-storage-rescue/drive-copy.sh:444
msgid "Searching by content"
msgstr "Recherche par contenu"

