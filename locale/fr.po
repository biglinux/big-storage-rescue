#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:22
msgid "Usage: big-storage-rescue [OPTION] [DEVICE|FOLDER]"
msgstr "Utilisation : big-storage-rescue [OPTION] [PÉRIPHÉRIQUE|DOSSIER]"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:25
msgid "(none)"
msgstr "(aucune)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:25
msgid "the application in a graphical session, the manager in a terminal"
msgstr "l’application dans une session graphique, le gestionnaire dans un terminal"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:26
msgid "the application: drives, health and file rescue"
msgstr "l’application : disques, santé et sauvetage de fichiers"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:27
msgid "the same application, opened on the health of the drive"
msgstr "la même application, ouverte sur la santé du disque"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:28
msgid "the same application, opened on the recovery of files from it"
msgstr "la même application, ouverte sur la récupération de ses fichiers"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:29
msgid "drive manager and file rescue in the terminal (big-storage-rescue --cli --help)"
msgstr "gestionnaire de disques et sauvetage de fichiers dans le terminal (big-storage-rescue --cli --help)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:30
msgid "storage overview, or details of one device (a whole disk: drive errors)"
msgstr "vue d’ensemble du stockage, ou détails d’un périphérique (disque entier : erreurs du disque)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:31
msgid "show what keeps a device busy"
msgstr "afficher ce qui maintient un périphérique occupé"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:32
msgid "unmount one filesystem safely"
msgstr "démonter un système de fichiers en toute sécurité"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:33
msgid "unmount every filesystem of the drive and power it off"
msgstr "démonter tous les systèmes de fichiers du disque et l’éteindre"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:34
msgid "with --safe-remove: unmount everything, do not power it off"
msgstr "avec --safe-remove : tout démonter, sans éteindre le disque"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:35
msgid "offer to close the programs that keep it busy"
msgstr "proposer de fermer les programmes qui l’occupent"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:36
msgid "do not ask before closing them or stopping services (scripts)"
msgstr "ne pas demander avant de les fermer ou d’arrêter des services (scripts)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:37
msgid "graphical diagnosis of one device (Dolphin menu)"
msgstr "diagnostic graphique d’un périphérique (menu de Dolphin)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:38
msgid "graphical safe removal (Dolphin menu)"
msgstr "retrait sécurisé graphique (menu de Dolphin)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:39
msgid "session service: warn about read-only devices"
msgstr "service de session : avertir des périphériques en lecture seule"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:40
msgid "bring the copies and settings of Big-Mount 2.x over (also done on start)"
msgstr "importer les copies et les paramètres de Big-Mount 2.x (fait aussi au démarrage)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:41
msgid "check the installation and the storage stack (for bug reports)"
msgstr "vérifier l’installation et la pile de stockage (pour les rapports de bogue)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:42
msgid "show the version and the source revision"
msgstr "afficher la version et la révision des sources"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:43
msgid "show this help"
msgstr "afficher cette aide"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:44
msgid "TARGET is a device (/dev/sdb1) or any folder inside a mounted device."
msgstr "TARGET est un périphérique (/dev/sdb1) ou n’importe quel dossier d’un périphérique monté."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:45
msgid "Machine-readable output: big-storage-rescue --cli COMMAND --json"
msgstr "Sortie exploitable par un programme : big-storage-rescue --cli COMMAND --json"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:123
#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:896
#: big-storage-rescue/usr/lib/big-storage-rescue/doctor.sh:441
#: big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:245
#: big-storage-rescue/usr/lib/big-storage-rescue/migrate.sh:190
msgid "big-storage-rescue: unknown option '%s' (see big-storage-rescue --help)"
msgstr "big-storage-rescue : option inconnue « %s » (voir big-storage-rescue --help)"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:141
msgid "The jobs of Big-Mount 2.x are not brought over by a dry run. To see them here, run first: big-storage-rescue --migrate-state"
msgstr "Une simulation n’importe pas les tâches de Big-Mount 2.x. Pour les voir ici, exécutez d’abord : big-storage-rescue --migrate-state"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:155
#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:219
#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:226
#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:248
msgid "Read-only device"
msgstr "Périphérique en lecture seule"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:158
msgid "Writing blocked here"
msgstr "Écriture bloquée ici"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:159
msgid "Writing was blocked on this drive in Big Storage Rescue, to protect it. It lasts until the drive is disconnected."
msgstr "L’écriture a été bloquée sur ce disque dans Big Storage Rescue, pour le protéger. Cela dure jusqu’à ce que le disque soit déconnecté."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:160
msgid "To write to it again, allow writing again, or disconnect it and connect it again."
msgstr "Pour y écrire de nouveau, autorisez à nouveau l’écriture, ou déconnectez-le et reconnectez-le."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:163
msgid "The drive itself accepts writing: it was blocked on this computer, by a program or a command (blockdev --setro). It is not the lock switch."
msgstr "Le disque lui-même accepte l’écriture : elle a été bloquée sur cet ordinateur, par un programme ou une commande (blockdev --setro). Ce n’est pas le verrou."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:164
msgid "Allow writing again (it asks for the administrator password), or disconnect the drive and connect it again."
msgstr "Autorisez à nouveau l’écriture (le mot de passe administrateur est demandé), ou déconnectez le disque et reconnectez-le."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:167
msgid "The card reader reports the card as locked: the lock switch on the side of the card, or of its adapter, is in the Lock position."
msgstr "Le lecteur de cartes indique que la carte est verrouillée : le verrou sur le côté de la carte, ou de son adaptateur, est en position Lock."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:168
msgid "Remove the card and slide the switch on its side up, towards the contacts. Then connect it again."
msgstr "Retirez la carte et faites glisser le verrou situé sur son côté vers le haut, vers les contacts. Puis reconnectez-la."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:169
msgid "A loose or broken switch slides back by itself: try another adapter, or cover the notch of the switch with a small piece of tape."
msgstr "Un verrou desserré ou cassé revient tout seul en arrière : essayez un autre adaptateur, ou couvrez l’encoche du verrou avec un petit morceau de ruban adhésif."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:170
msgid "Card readers sometimes read the switch wrong: try another reader, or another USB port."
msgstr "Les lecteurs de cartes lisent parfois mal le verrou : essayez un autre lecteur, ou un autre port USB."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:171
msgid "If it stays locked with the switch unlocked, in two readers, the card locked itself because of wear. It cannot be unlocked: copy your files now and replace it."
msgstr "Si la carte reste verrouillée avec le verrou en position déverrouillée, dans deux lecteurs, elle s’est verrouillée elle-même à cause de l’usure. Elle ne peut pas être déverrouillée : copiez vos fichiers maintenant et remplacez-la."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:174
msgid "The card itself is set to refuse writing. This protection is stored inside the card: it is not the lock switch."
msgstr "La carte elle-même est réglée pour refuser l’écriture. Cette protection est enregistrée dans la carte : ce n’est pas le verrou."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:175
msgid "A camera, phone or tool that locked it may unlock it in its own menu (often called protect or lock card)."
msgstr "L’appareil photo, le téléphone ou l’outil qui l’a verrouillée peut la déverrouiller dans son propre menu (souvent appelé protéger ou verrouiller la carte)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:176
msgid "Linux has no safe tool to clear it. Copy your files to another place."
msgstr "Linux n’a pas d’outil sûr pour retirer cette protection. Copiez vos fichiers ailleurs."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:177
msgid "If it cannot be unlocked, use another card."
msgstr "Si elle ne peut pas être déverrouillée, utilisez une autre carte."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:180
msgid "The card was locked for good by its own controller, usually at the end of its life. This cannot be undone."
msgstr "La carte a été verrouillée définitivement par son propre contrôleur, généralement en fin de vie. C’est irréversible."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:181
msgid "Copy your files to another place now, while they can still be read."
msgstr "Copiez vos fichiers ailleurs maintenant, tant qu’ils peuvent encore être lus."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:182
msgid "Replace the card: no program can unlock it."
msgstr "Remplacez la carte : aucun programme ne peut la déverrouiller."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:185
msgid "This disk image was attached read-only."
msgstr "Cette image disque a été attachée en lecture seule."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:186
msgid "To change it, detach it and attach it again with writing enabled."
msgstr "Pour la modifier, détachez-la et attachez-la de nouveau avec l’écriture activée."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:189
msgid "The device itself is write-protected, so no system can write to it."
msgstr "Le périphérique lui-même est protégé en écriture : aucun système ne peut y écrire."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:190
msgid "SD cards and some USB drives have a small lock switch on the side. Remove the device, move the switch to the unlocked position and connect it again."
msgstr "Les cartes SD et certaines clés USB ont un petit verrou sur le côté. Retirez le périphérique, placez le verrou en position déverrouillée et reconnectez-le."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:191
msgid "If there is no switch, the device may have locked itself because of wear. Copy your files to another place as soon as possible."
msgstr "S’il n’y a pas de verrou, le périphérique s’est peut-être verrouillé lui-même à cause de l’usure. Copiez vos fichiers ailleurs dès que possible."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:196
msgid "Allow writing again"
msgstr "Autoriser à nouveau l’écriture"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:197
msgid "Writing is allowed again on the device. Nothing on it is changed. The administrator password may be requested."
msgstr "L’écriture est de nouveau autorisée sur le périphérique. Rien n’y est modifié. Le mot de passe administrateur peut être demandé."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:207
#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1254
msgid "Device ready"
msgstr "Périphérique prêt"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:208
msgid "You can read and write files on this device."
msgstr "Vous pouvez lire et écrire des fichiers sur ce périphérique."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:211
msgid "Device not mounted"
msgstr "Périphérique non monté"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:212
msgid "The filesystem is not mounted at the moment."
msgstr "Le système de fichiers n’est pas monté pour le moment."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:213
msgid "Open the device in the file manager (Dolphin) to mount it."
msgstr "Ouvrez le périphérique dans le gestionnaire de fichiers (Dolphin) pour le monter."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:220
msgid "This kind of filesystem cannot be written on Linux with the driver in use."
msgstr "Ce type de système de fichiers n’est pas accessible en écriture sous Linux avec le pilote utilisé."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:221
msgid "CDs, DVDs and disk images (ISO, SquashFS) are read-only by nature."
msgstr "Les CD, les DVD et les images disque (ISO, SquashFS) sont en lecture seule par nature."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:222
msgid "Drives formatted on a Mac (HFS+ with journaling, APFS) can only be read on Linux."
msgstr "Les disques formatés sur un Mac (HFS+ journalisé, APFS) ne peuvent qu’être lus sous Linux."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:223
msgid "To write to it, copy the files elsewhere and format the device with a filesystem such as exFAT. Formatting erases everything on it."
msgstr "Pour y écrire, copiez les fichiers ailleurs et formatez le périphérique avec un système de fichiers comme exFAT. Le formatage efface tout son contenu."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:227
msgid "Windows did not close this NTFS partition properly (hibernation, Fast Startup or an interrupted shutdown). Writing to it now could damage files."
msgstr "Windows n’a pas fermé correctement cette partition NTFS (mise en veille prolongée, démarrage rapide ou arrêt interrompu). Y écrire maintenant pourrait endommager des fichiers."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:228
msgid "Start Windows and shut it down completely: hold the Shift key while you click Shut down."
msgstr "Démarrez Windows et arrêtez-le complètement : maintenez la touche Maj enfoncée pendant que vous cliquez sur Arrêter."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:229
msgid "To avoid this in the future, disable Fast Startup in Windows: Control Panel > Power Options > Choose what the power buttons do."
msgstr "Pour éviter cela à l’avenir, désactivez le démarrage rapide dans Windows : Panneau de configuration > Options d’alimentation > Choisir l’action des boutons d’alimentation."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:230
msgid "If it still happens, check the partition in Windows: open the Command Prompt as administrator and run chkdsk with the /f option for that drive letter."
msgstr "Si cela se reproduit, vérifiez la partition sous Windows : ouvrez l’invite de commandes en tant qu’administrateur et exécutez chkdsk avec l’option /f pour cette lettre de lecteur."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:231
msgid "Big Storage Rescue never repairs NTFS by itself, because the repair tools available on Linux may discard data that Windows still needs."
msgstr "Big Storage Rescue ne répare jamais NTFS de lui-même, car les outils de réparation disponibles sous Linux peuvent supprimer des données dont Windows a encore besoin."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:234
msgid "The filesystem needs attention"
msgstr "Le système de fichiers requiert votre attention"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:235
msgid "The system found errors in the filesystem and stopped writing to it to protect your files."
msgstr "Le système a trouvé des erreurs dans le système de fichiers et a cessé d’y écrire pour protéger vos fichiers."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:236
msgid "First copy your important files to another place."
msgstr "Copiez d’abord vos fichiers importants ailleurs."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:237
msgid "Then check the filesystem with the device unmounted, for example with KDE Partition Manager (Check)."
msgstr "Vérifiez ensuite le système de fichiers, périphérique démonté, par exemple avec le Gestionnaire de partitions de KDE (Vérifier)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:238
msgid "Do not write to the device until it has been checked."
msgstr "N’écrivez rien sur le périphérique tant qu’il n’a pas été vérifié."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:241
msgid "The device has read or write errors"
msgstr "Le périphérique présente des erreurs de lecture ou d’écriture"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:242
msgid "The device reported read or write errors. This is usually a bad cable, a weak USB port or a failing drive."
msgstr "Le périphérique a signalé des erreurs de lecture ou d’écriture. La cause est généralement un câble défectueux, un port USB trop faible ou un disque défaillant."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:243
#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:1021
msgid "Copy your important files to another place as soon as possible."
msgstr "Copiez vos fichiers importants ailleurs dès que possible."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:244
msgid "Try another cable and connect the device directly to the computer, without a hub."
msgstr "Essayez un autre câble et branchez le périphérique directement sur l’ordinateur, sans concentrateur."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:245
msgid "Check the health of the drive in KDE Partition Manager (SMART status)."
msgstr "Vérifiez la santé du disque dans le Gestionnaire de partitions de KDE (état SMART)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:249
msgid "The filesystem was mounted read-only, but no problem was found with it."
msgstr "Le système de fichiers a été monté en lecture seule, mais aucun problème n’y a été trouvé."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:250
msgid "Mount it again with writing enabled."
msgstr "Remontez-le avec l’écriture activée."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:251
msgid "Mount again with writing"
msgstr "Remonter en écriture"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:252
msgid "The device will be unmounted and mounted again with writing enabled. Nothing on it is changed. Programs using it must be closed first."
msgstr "Le périphérique sera démonté puis remonté avec l’écriture activée. Rien n’y est modifié. Les programmes qui l’utilisent doivent d’abord être fermés."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:255
#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:263
#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:268
#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:282
msgid "No permission to write"
msgstr "Aucune autorisation d’écriture"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:256
msgid "The device accepts writing, but its main folder belongs to another user and you are not allowed to change it."
msgstr "Le périphérique accepte l’écriture, mais son dossier principal appartient à un autre utilisateur et vous n’êtes pas autorisé à le modifier."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:257
msgid "You can become the owner of the main folder. Only that folder changes: the files and folders inside it keep their owners."
msgstr "Vous pouvez devenir propriétaire du dossier principal. Seul ce dossier change : les fichiers et dossiers qu’il contient gardent leurs propriétaires."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:258
msgid "This is the usual fix for drives formatted with a Linux filesystem (ext4, Btrfs, XFS)."
msgstr "C’est la solution habituelle pour les disques formatés avec un système de fichiers Linux (ext4, Btrfs, XFS)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:259
msgid "Become owner of the main folder"
msgstr "Devenir propriétaire du dossier principal"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:260
msgid "The main folder of the device will belong to you (not recursive: the files and folders inside keep their owners). The administrator password may be requested."
msgstr "Le dossier principal du périphérique vous appartiendra (non récursif : les fichiers et dossiers qu’il contient gardent leurs propriétaires). Le mot de passe administrateur peut être demandé."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:264
msgid "This partition contains an operating system. Its folders belong to that system and must keep their owners."
msgstr "Cette partition contient un système d’exploitation. Ses dossiers appartiennent à ce système et doivent garder leurs propriétaires."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:265
msgid "Save your files in a folder that belongs to you, for example your home folder on that system."
msgstr "Enregistrez vos fichiers dans un dossier qui vous appartient, par exemple votre dossier personnel sur ce système."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:269
msgid "This folder belongs to %s, and only its owner can create or change files in it."
msgstr "Ce dossier appartient à %s, et seul son propriétaire peut y créer ou modifier des fichiers."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:270
msgid "Save your files in a folder of your own, for example in your home folder."
msgstr "Enregistrez vos fichiers dans un dossier qui vous appartient, par exemple votre dossier personnel."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:273
msgid "System partition"
msgstr "Partition système"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:274
msgid "This partition holds the operating system that is running now. Only the system and administrators write here."
msgstr "Cette partition contient le système d’exploitation en cours d’exécution. Seuls le système et les administrateurs y écrivent."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:275
msgid "Save your files in your home folder."
msgstr "Enregistrez vos fichiers dans votre dossier personnel."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:278
msgid "Swap space"
msgstr "Espace d’échange"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:279
msgid "This partition is used as swap space (virtual memory), not to store files."
msgstr "Cette partition sert d’espace d’échange (mémoire virtuelle), pas à stocker des fichiers."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:283
msgid "The device was mounted for another user, so only that user can write to it."
msgstr "Le périphérique a été monté pour un autre utilisateur : seul cet utilisateur peut y écrire."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:284
msgid "Unmount it and open it again from the file manager while you are logged in."
msgstr "Démontez-le et rouvrez-le depuis le gestionnaire de fichiers dans votre session."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:286
msgid "This internal partition is mounted by Big-Mount at boot. An administrator can choose who may write to it with PERMISSIONS in /etc/big-mount.conf."
msgstr "Cette partition interne est montée par Big-Mount au démarrage. Un administrateur peut choisir qui peut y écrire avec PERMISSIONS dans /etc/big-mount.conf."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:288
msgid "Mount again for my user"
msgstr "Remonter pour mon utilisateur"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:289
