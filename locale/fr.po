msgid "Stop them and continue"
msgstr "Les arrêter et continuer"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:952
msgid "Nothing was done. Run again with --assume-yes to stop them."
msgstr "Rien n’a été fait. Relancez avec --assume-yes pour les arrêter."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:956
msgid "Unmounted, but powering the drive off failed (%s). Wait a moment before disconnecting it."
msgstr "Démonté, mais l’extinction du disque a échoué (%s). Attendez un instant avant de le déconnecter."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:957
#: big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:535
msgid "Refused: this drive holds the running system (%s)."
msgstr "Refusé : ce disque contient le système en cours d’exécution (%s)."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:958
#: big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:536
