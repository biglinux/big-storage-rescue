msgstr "Démonté. Ce disque ne peut pas être éteint par l’ordinateur ; il peut maintenant être déconnecté."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:963
#: big-storage-rescue/usr/lib/big-storage-rescue/drive.sh:542
msgid "Could not unmount: %s"
msgstr "Impossible de démonter : %s"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:984
msgid "The drive reports errors"
msgstr "Le disque signale des erreurs"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:985
msgid "The drive had errors before this start of the computer"
msgstr "Le disque a eu des erreurs avant ce démarrage de l’ordinateur"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:986
