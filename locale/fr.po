msgstr "Un fichier ouvert ne signifie pas forcément qu’une copie est en cours."

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:706
msgid "%s is not in use"
msgstr "%s n’est pas utilisé"

#: big-storage-rescue/usr/lib/big-storage-rescue/cli.sh:708
